[Unit]
Description=Oura global webhook listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/oura_webhook_listener
EnvironmentFile=/etc/oura-listener.env
RuntimeDirectory=oura-listener
ExecStart=/home/ec2-user/oura_env/bin/gunicorn --bind 127.0.0.1:5000 --workers 1 --worker-class gthread --threads 4 --timeout 30 --max-requests 1000 --max-requests-jitter 100 --access-logfile /dev/null --error-logfile - run_webhook:app
Restart=on-failure
RestartSec=5
MemoryHigh=140M
MemoryMax=180M
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
